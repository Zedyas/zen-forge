{
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "electron-vite/node"
    ]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "electron/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
